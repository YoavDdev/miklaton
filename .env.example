# ================================================
# Miklaton — Environment Variables Example
# העתק ל-.env.local ומלא ערכים אמיתיים.
# אין לשמור ערכים אמיתיים בקובץ הזה! (הוא נמצא ב-git)
# ================================================

# JWT (חובה! מינימום 32 תווים אקראיים)
JWT_SECRET=generate_a_random_secret_at_least_32_chars

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OpenAI API Key (for Knowledge Base AI Chat)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Maps (geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Legacy passwords (מנגנון ישן - ראה docs/07-maintenance.md)
APP_PASSWORD=change_me
ADMIN_PASSWORD=change_me

# External links
NEXT_PUBLIC_EKRON_URL=https://forms.example.com/ekron
NEXT_PUBLIC_INCIDENT_FORM_URL=https://forms.example.com/incident

# Municipality Configuration (change per municipality)
NEXT_PUBLIC_MUNICIPALITY_NAME=עיריית יהוד-מונוסון
NEXT_PUBLIC_MUNICIPALITY_SHORT=יהוד-מונוסון
NEXT_PUBLIC_MUNICIPALITY_ID=yehud
NEXT_PUBLIC_MUNICIPALITY_LOGO=/images/yehud-logo.png
NEXT_PUBLIC_PRIMARY_COLOR=#7c3aed
NEXT_PUBLIC_SYSTEM_NAME=מקלטון
NEXT_PUBLIC_SYSTEM_SUBTITLE=מערכת ניהול אירועי חירום
